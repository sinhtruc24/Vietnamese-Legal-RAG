INDEX_DIR=indexes/full
RETRIEVER=hybrid            # bm25 | dense | hybrid
USE_RERANKER=true
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CANDIDATES=20
CONTEXT_K=3
REFUSAL_THRESHOLD=         # điểm reranker tối thiểu để gọi LLM; để trống = tắt cổng (giá trị: results/refusal_gate.json)

LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=legal-lora
LLM_API_KEY=EMPTY

# only for scripts/build_sft_data.py and the LLM-as-judge
TEACHER_API_KEY=
JUDGE_API_KEY=
